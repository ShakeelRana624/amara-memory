# Multi-stage production Dockerfile for AMARA FastAPI Backend & CLI
# Base image: Python 3.12-slim
FROM python:3.12-slim AS builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency resolution
COPY --from=ghcr.io/astral-sh/uv:0.5.21 /uv /uvx /bin/

# Copy dependency manifests
COPY pyproject.toml uv.lock ./
COPY src/ ./src/
COPY README.md LICENSE ./

# Build wheel package
RUN uv build --wheel --out-dir /build/dist

# ----------------------------------------------------------------------------
# Runtime Stage
# ----------------------------------------------------------------------------
FROM python:3.12-slim AS runtime

WORKDIR /app

# Install runtime system packages and security updates
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Install uv in runtime for fast installs
COPY --from=ghcr.io/astral-sh/uv:0.5.21 /uv /uvx /bin/

# Copy built wheel from builder stage
COPY --from=builder /build/dist/*.whl /tmp/

# Install AMARA wheel and production dependencies
RUN uv pip install --system /tmp/*.whl && rm -rf /tmp/*.whl

# Copy database migrations and configuration
COPY alembic.ini ./
COPY migrations/ ./migrations/
COPY deploy/scripts/entrypoint-api.sh /usr/local/bin/entrypoint-api.sh
RUN chmod +x /usr/local/bin/entrypoint-api.sh

# Create non-root unprivileged service user
RUN groupadd -g 10001 amara && \
    useradd -u 10001 -g amara -s /bin/bash -m amara && \
    mkdir -p /app/data /tmp/amara && \
    chown -R amara:amara /app /tmp/amara

USER amara

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    AMARA_STORAGE_BACKEND=postgres \
    AMARA_ENV=production \
    PORT=8000

EXPOSE 8000

# Container liveness and readiness probe
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint-api.sh"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8000", "--workers", "4", "--storage", "postgres"]

