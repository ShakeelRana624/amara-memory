# ==============================================================================
# AMARA Environment Configuration — Staging
# ==============================================================================
AMARA_ENV=staging
AMARA_LOG_LEVEL=INFO

# Storage Configuration (PostgreSQL 16+ with pgvector)
AMARA_STORAGE_BACKEND=postgres
AMARA_DATABASE_URL=postgresql+asyncpg://amara_staging:SECURE_STAGING_PASSWORD@staging-db.amara.internal:5432/amara_staging
AMARA_DB_POOL_SIZE=15
AMARA_DB_MAX_OVERFLOW=10

# Server & Ingress
PORT=8000
HOST=0.0.0.0
RELOAD=false
WORKERS=2
AMARA_CORS_ORIGINS=https://staging.amara.ai,https://staging-app.amara.ai

# Security & API Keys
AMARA_SECRET_KEY=GENERATE_RANDOM_256_BIT_SECRET_FOR_STAGING
AMARA_RATE_LIMIT_PER_MINUTE=300
AMARA_MAX_REQUEST_SIZE_BYTES=10485760

# Background Worker
AMARA_WORKER_INTERVAL=60
AMARA_WORKER_TENANTS=staging_tenant_alpha,staging_tenant_beta,default
