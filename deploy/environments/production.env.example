# ==============================================================================
# AMARA Environment Configuration — Production
# ==============================================================================
AMARA_ENV=production
AMARA_LOG_LEVEL=INFO

# Storage Configuration (Managed Cloud PostgreSQL 16+ with pgvector & High Availability)
AMARA_STORAGE_BACKEND=postgres
AMARA_DATABASE_URL=postgresql+asyncpg://amara_prod_app:STRONG_RANDOMLY_GENERATED_PASSWORD@prod-db.amara.internal:5432/amara_prod?ssl=require
AMARA_DB_POOL_SIZE=30
AMARA_DB_MAX_OVERFLOW=20
AMARA_DB_POOL_RECYCLE=1800
AMARA_DB_POOL_TIMEOUT=15.0

# Server & Ingress
PORT=8000
HOST=0.0.0.0
RELOAD=false
WORKERS=4
AMARA_CORS_ORIGINS=https://app.amara.ai,https://api.amara.ai

# Security & API Key Policies
AMARA_SECRET_KEY=SECURE_HEX_ENCODED_512_BIT_SECRET_KEY
AMARA_RATE_LIMIT_PER_MINUTE=120
AMARA_MAX_REQUEST_SIZE_BYTES=10485760
AMARA_FORCE_HTTPS=true

# Background Lifecycle Worker
AMARA_WORKER_INTERVAL=60
AMARA_WORKER_TENANTS=production,enterprise_default
AMARA_WORKER_HEARTBEAT=/tmp/amara/worker-heartbeat

# Telemetry & Monitoring
AMARA_METRICS_ENABLED=true
AMARA_AUDIT_LOG_ENABLED=true

