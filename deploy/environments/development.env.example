# ==============================================================================
# AMARA Environment Configuration — Development
# ==============================================================================
AMARA_ENV=development
AMARA_LOG_LEVEL=DEBUG

# Storage Configuration
AMARA_STORAGE_BACKEND=postgres
AMARA_DATABASE_URL=postgresql+asyncpg://amara:amara@localhost:5432/amara_dev
AMARA_DB_POOL_SIZE=5
AMARA_DB_MAX_OVERFLOW=5

# Server & Ingress
PORT=8000
HOST=0.0.0.0
RELOAD=true
AMARA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & API Keys
AMARA_SECRET_KEY=dev_insecure_secret_key_change_in_production
AMARA_RATE_LIMIT_PER_MINUTE=600

# Background Worker
AMARA_WORKER_INTERVAL=30
AMARA_WORKER_TENANTS=dev_tenant,default
