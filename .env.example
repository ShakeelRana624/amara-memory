# AMARA Environment Configuration Template
# Copy this file to .env and customize values for local development.
# Do NOT commit production secrets or real API keys to version control.

# Application Environment (development, testing, production)
AMARA_ENV=development
AMARA_LOG_LEVEL=INFO

# Storage & Cache Configuration
AMARA_STORAGE_BACKEND=in_memory
AMARA_STORAGE_PATH=./.amara_data

# Telemetry & Diagnostics (Opt-in)
AMARA_TELEMETRY_ENABLED=false

# Future SaaS / Service Configuration (Stub)
# AMARA_API_PORT=8000
# AMARA_API_HOST=127.0.0.1
